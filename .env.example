SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-google-account@gmail.com
SMTP_PASS=replace-with-google-app-password
SMTP_FROM=your-google-account@gmail.com
CONTACT_TO=support@lohn-mail.de

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
RECAPTCHA_MIN_SCORE=0.5
